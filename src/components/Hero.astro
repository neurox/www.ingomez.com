---
import { t } from '../i18n/translations';
import StudioGraphic from './StudioGraphic.astro';
const locale = Astro.currentLocale as 'en' | 'es';
---
<section class="hero hero-engineering">
  <div class="hero-index"><span>INGOMEZ — {locale === 'es' ? 'ESTUDIO INDEPENDIENTE' : 'INDEPENDENT STUDIO'}</span><span>{locale === 'es' ? 'DESDE MÉXICO / PARA EL MUNDO' : 'FROM MEXICO / WORLDWIDE'}</span></div>
  <div class="hero-layout">
    <div class="hero-editorial">
      <span class="eyebrow">{locale === 'es' ? 'La diferencia está en cómo nos conectamos.' : 'The difference is how we connect.'}</span>
      <h1>{locale === 'es' ? 'Distintas' : 'Different'}<br />{locale === 'es' ? 'mentes.' : 'minds.'}<br /><em>{locale === 'es' ? 'Software que' : 'Software that'}<br />{locale === 'es' ? 'funciona.' : 'works.'}</em></h1>
      <p class="hero-copy">{locale === 'es' ? 'Diseñamos software a medida para negocios que necesitan conectar herramientas, reducir tareas manuales o crear un nuevo servicio digital. Unimos diseño e ingeniería para resolverlo contigo.' : 'We design custom software for businesses that need to connect tools, reduce manual work or create a new digital service. We bring design and engineering together to solve it with you.'}</p>
      <div class="hero-actions">
        <a class="btn-primary" href="#contact">{t('header.getQuote', locale)} <span class="ml-5" aria-hidden="true">↗</span></a>
        <a class="text-link" href="#services">{t('hero.servicesLink', locale)} <span aria-hidden="true">↓</span></a>
      </div>
    </div>
    <StudioGraphic />
  </div>
  <div class="hero-discipline"><span>01 / {locale === 'es' ? 'DISEÑO' : 'DESIGN'}</span><span>02 / SOFTWARE</span><span>03 / {locale === 'es' ? 'INTELIGENCIA ARTIFICIAL' : 'ARTIFICIAL INTELLIGENCE'}</span><span>04 / {locale === 'es' ? 'AUTOMATIZACIÓN' : 'AUTOMATION'}</span></div>
</section>
