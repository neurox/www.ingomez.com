---
import { t } from '../i18n/translations';

const locale = Astro.currentLocale as 'en' | 'es';
---

<section id="services" class="py-16 border-t border-brand-dark">
  <div class="mb-10">
    <span class="text-xs font-bold uppercase tracking-widest text-brand-orange">{t('services.label', locale)}</span>
    <h2 class="mt-2 font-display text-4xl sm:text-5xl font-bold uppercase leading-none tracking-tight text-brand-navy">{t('services.title', locale)}</h2>
    <p class="mt-4 text-brand-brown text-lg max-w-2xl">{t('services.copy', locale)}</p>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
    {[0, 1, 2, 3].map(i => (
      <article class="card-outline group">
        <div class="flex justify-between items-start">
          <span class="font-display text-5xl font-bold text-brand-orange group-hover:text-brand-orange">
            0{i + 1}
          </span>
          {i === 0 && (
            <svg class="tech-icon" viewBox="0 0 40 40" fill="none" stroke="#00e5ff" stroke-width="1.5">
              <rect x="4" y="8" width="32" height="6" rx="2" />
              <rect x="8" y="18" width="24" height="6" rx="2" />
              <rect x="12" y="28" width="16" height="6" rx="2" />
            </svg>
          )}
          {i === 1 && (
            <svg class="tech-icon" viewBox="0 0 40 40" fill="none" stroke="#00e5ff" stroke-width="1.5">
              <rect x="8" y="8" width="24" height="24" rx="4" />
              <circle cx="20" cy="20" r="5" />
              <circle cx="20" cy="20" r="2" fill="#00e5ff" />
              <line x1="8" y1="14" x2="4" y2="14" />
              <line x1="8" y1="20" x2="4" y2="20" />
              <line x1="8" y1="26" x2="4" y2="26" />
              <line x1="32" y1="14" x2="36" y2="14" />
              <line x1="32" y1="20" x2="36" y2="20" />
              <line x1="32" y1="26" x2="36" y2="26" />
              <line x1="14" y1="8" x2="14" y2="4" />
              <line x1="20" y1="8" x2="20" y2="4" />
              <line x1="26" y1="8" x2="26" y2="4" />
              <line x1="14" y1="32" x2="14" y2="36" />
              <line x1="20" y1="32" x2="20" y2="36" />
              <line x1="26" y1="32" x2="26" y2="36" />
            </svg>
          )}
          {i === 2 && (
            <svg class="tech-icon" viewBox="0 0 40 40" fill="none" stroke="#00e5ff" stroke-width="1.5">
              <circle cx="20" cy="20" r="14" />
              <circle cx="20" cy="20" r="4" fill="#00e5ff" stroke="none" />
              <line x1="20" y1="6" x2="20" y2="2" />
              <line x1="20" y1="38" x2="20" y2="34" />
              <line x1="6" y1="20" x2="2" y2="20" />
              <line x1="38" y1="20" x2="34" y2="20" />
              <line x1="10" y1="10" x2="7" y2="7" />
              <line x1="33" y1="33" x2="30" y2="30" />
              <line x1="30" y1="10" x2="33" y2="7" />
              <line x1="7" y1="33" x2="10" y2="30" />
            </svg>
          )}
          {i === 3 && (
            <svg class="tech-icon" viewBox="0 0 40 40" fill="none" stroke="#00e5ff" stroke-width="1.5">
              <path d="M20,4 L34,12 L34,28 L20,36 L6,28 L6,12 Z" />
              <polyline points="14,20 18,24 26,16" stroke-width="2" />
            </svg>
          )}
        </div>
        <h3 class="mt-4 font-display text-xl font-bold uppercase tracking-tight">{t(`services.items.${i}.title`, locale)}</h3>
        <p class="mt-2 text-sm text-brand-brown leading-relaxed group-hover:text-brand-brown">{t(`services.items.${i}.desc`, locale)}</p>
      </article>
    ))}
  </div>
</section>
