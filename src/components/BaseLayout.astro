---
import '../styles/global.css';
import Header from './Header.astro';
import Footer from './Footer.astro';
import { t } from '../i18n/translations';

interface Props {
  title?: string;
  description?: string;
}

const locale = Astro.currentLocale as 'en' | 'es';
const siteTitle = 'INGOMEZ';
const defaultDesc = locale === 'es'
  ? 'Equipo independiente de desarrollo web, integración de IA y automatización. Profesionales con experiencia internacional para clientes de todo el mundo.'
  : 'Independent web development, AI integration, and automation team. Professionals with international experience serving clients worldwide.';

const pageTitle = Astro.props.title
  ? `${Astro.props.title} | ${siteTitle}`
  : `${locale === 'es' ? 'Desarrollo web, IA y automatización' : 'Web Development, AI & Automation'} | ${siteTitle}`;
const metaDesc = Astro.props.description || defaultDesc;
const isNotFound = Astro.props.title === '404';
const canonical = new URL(locale === 'en' ? '/en/' : '/', Astro.site).href;
const organization = {'@context':'https://schema.org','@type':'Organization',name:'INGOMEZ',url:Astro.site?.href,description:metaDesc,knowsAbout:['Custom software','Web development','Artificial intelligence','Process automation']};
---

<!doctype html>
<html lang={locale === 'es' ? 'es-MX' : 'en-US'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={metaDesc} />
    {isNotFound ? <meta name="robots" content="noindex, follow" /> : <>
      <link rel="canonical" href={canonical} />
      <link rel="alternate" hreflang="es" href="https://www.ingomez.com/" />
      <link rel="alternate" hreflang="en" href="https://www.ingomez.com/en/" />
      <link rel="alternate" hreflang="x-default" href="https://www.ingomez.com/" />
      <meta property="og:type" content="website" />
      <meta property="og:site_name" content="INGOMEZ" />
      <meta property="og:title" content={pageTitle} />
      <meta property="og:description" content={metaDesc} />
      <meta property="og:url" content={canonical} />
      <meta name="twitter:card" content="summary" />
      <script type="application/ld+json" set:html={JSON.stringify(organization)} />
    </>}
    <meta name="theme-color" content="#f7f7f2" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-ZWW4W6JVX6"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-ZWW4W6JVX6');
    </script>
  </head>
  <body class="min-h-screen border-8 border-brand-dark bg-brand-bg">
    <a class="skip-link absolute left-4 -top-16 z-50 bg-brand-orange text-[#0a0b10] px-4 py-2 rounded-full font-medium focus:top-4 transition-all" href="#main-content">
      {t('skipToContent', locale)}
    </a>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <Header locale={locale} />
      <main id="main-content">
        <slot />
      </main>
      <Footer locale={locale} />
    </div>
  </body>
</html>
