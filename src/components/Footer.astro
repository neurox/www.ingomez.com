---
import { t } from '../i18n/translations';


const locale = Astro.currentLocale as 'en' | 'es';
const homeUrl = locale === 'es' ? '/' : '/en/';
---

<footer class="border-t border-brand-dark">
  <div class="py-12">
    <div class="grid grid-cols-1 md:grid-cols-[2fr_1fr_1fr_1fr] gap-8">
      <div>
        <a class="brand-home" href={homeUrl} aria-label="INGOMEZ"><img src="/brand/ingomez-logo.svg" width="760" height="190" alt="INGOMEZ" /></a>
        <p class="mt-4 text-brand-brown max-w-md text-sm leading-relaxed">
          {t('footer.tagline', locale)}
        </p>
      </div>
      <div>
        <h2 class="text-sm font-display font-bold uppercase tracking-widest text-brand-orange mb-4">{t('footer.services', locale)}</h2>
        <div class="flex flex-col gap-2">
          <a href={`${homeUrl}#services`} class="text-sm text-brand-brown hover:text-brand-orange transition-colors">{t('footer.webPlatforms', locale)}</a>
          <a href={`${homeUrl}#services`} class="text-sm text-brand-brown hover:text-brand-orange transition-colors">{t('footer.aiIntegration', locale)}</a>
          <a href={`${homeUrl}#services`} class="text-sm text-brand-brown hover:text-brand-orange transition-colors">{t('footer.automation', locale)}</a>
          <a href={`${homeUrl}#services`} class="text-sm text-brand-brown hover:text-brand-orange transition-colors">{t('footer.consulting', locale)}</a>
        </div>
      </div>
      <div>
        <h2 class="text-sm font-display font-bold uppercase tracking-widest text-brand-orange mb-4">{t('footer.company', locale)}</h2>
        <div class="flex flex-col gap-2">
          <a href={`${homeUrl}#process`} class="text-sm text-brand-brown hover:text-brand-orange transition-colors">{t('footer.process', locale)}</a>
          <a href={`${homeUrl}#model`} class="text-sm text-brand-brown hover:text-brand-orange transition-colors">{t('footer.about', locale)}</a>
        </div>
      </div>
      <div>
        <h2 class="text-sm font-display font-bold uppercase tracking-widest text-brand-orange mb-4">{t('footer.contact', locale)}</h2>
        <div class="flex flex-col gap-2">
          <a href="mailto:juanjose@ingomez.com" class="text-sm text-brand-brown hover:text-brand-orange transition-colors">juanjose@ingomez.com</a>
          <span class="text-sm text-brand-brown">Cuernavaca, Morelos</span>
        </div>
      </div>
    </div>
    <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 mt-8 pt-6 border-t border-brand-dark text-xs text-brand-brown">
      <div><div set:html={t('footer.copyright', locale)} /><a class="block mt-2 underline underline-offset-4" href="/credits/head-scan.txt">{locale === 'es' ? 'Escaneo 3D: Lee Perry-Smith · CC BY 3.0 · Adaptado por INGOMEZ' : '3D scan: Lee Perry-Smith · CC BY 3.0 · Adapted by INGOMEZ'}</a></div>
      <div>
        <a href="#" class="hover:text-brand-orange transition-colors">{locale === 'es' ? 'Ir arriba' : 'Go to top'}</a>
      </div>
    </div>
  </div>
</footer>
