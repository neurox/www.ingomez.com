---
import { createSculptedHead } from '../scripts/sculpted-head';
const { nodes } = createSculptedHead(.095);
const face = nodes.filter(p=>p.z>=0).sort((a,b)=>a.z-b.z);
const project=(p:{x:number;y:number;z:number})=>({x:250+p.x*77,y:275-(p.y*.988+p.z*.15)*77});
---
<div class="assembly" data-assembly aria-hidden="true">
  <div class="assembly-viewport">
    <svg class="assembly-fallback" viewBox="0 0 500 540" fill="none">
      <g transform="translate(250 275) scale(1.2) translate(-250 -275)">
        {face.map(p=><rect x={project(p).x-2} y={project(p).y-2} width="4" height="5" fill={'#'+p.color.toString(16).padStart(6,'0')}/>)}
      </g>
    </svg>
    <div class="assembly-canvas"></div>
  </div>
</div>
<script>
  const host = document.querySelector<HTMLElement>('[data-assembly]');
  if (host && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    import('../scripts/assembly').then(({ mountAssembly }) => mountAssembly(host)).catch(() => {});
  }
</script>
<style>
  .assembly {background:transparent;border:0;box-shadow:none}
  .assembly-viewport {position:relative;min-height:640px;overflow:hidden;isolation:isolate;background:transparent}
  .assembly-fallback,.assembly-canvas {position:absolute;inset:0;width:100%;height:100%;filter:none}
  .assembly-canvas {z-index:1}
  @media(max-width:767px){.assembly-viewport{min-height:510px}}
</style>
