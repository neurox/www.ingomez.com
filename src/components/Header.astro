---
import { t } from '../i18n/translations';
import LogoSVG from './LogoSVG.astro';

const locale = Astro.currentLocale as 'en' | 'es';
const homeUrl = locale === 'es' ? '/' : '/en/';

const navItems = [
  { id: 'services', key: 'header.services' },
  { id: 'process', key: 'header.process' },
  { id: 'model', key: 'header.model' },
  { id: 'about', key: 'header.about' },
];
---

<header class="sticky top-0 z-20 bg-brand-bg/95 backdrop-blur-sm border-b border-brand-dark">
  <div class="flex items-center justify-between gap-4 min-h-[72px]">
    <a class="flex items-center gap-3 font-display text-2xl font-bold uppercase tracking-tight text-brand-navy" href={homeUrl}>
      <span class="inline-grid place-items-center w-10 h-10 rounded-lg bg-brand-orange">
          <LogoSVG variant="light" />
        </span>
      INGOMEZ
    </a>

    <button
      class="menu-toggle lg:hidden inline-grid place-items-center w-11 h-11 border border-brand-orange rounded-lg bg-brand-bg text-brand-orange"
      type="button"
      aria-expanded="false"
      aria-controls="site-nav"
      aria-label={t('header.openNav', locale)}
    >
      <span class="block w-4 h-0.5 bg-current rounded-full relative before:block before:w-4 before:h-0.5 before:bg-current before:rounded-full before:-translate-y-1.5 after:block after:w-4 after:h-0.5 after:bg-current after:rounded-full after:translate-y-1"></span>
    </button>

    <nav class="site-nav hidden lg:flex items-center gap-8" id="site-nav" aria-label={t('header.navAria', locale)}>
      <div class="flex items-center gap-1">
        {navItems.map(item => (
          <a href={`${homeUrl}#${item.id}`} class="px-4 py-2 rounded-full text-sm font-medium text-brand-navy hover:text-brand-orange transition-colors">
            {t(item.key, locale)}
          </a>
        ))}
      </div>
      <div class="flex items-center gap-3">
        <div class="flex items-center gap-0.5 border border-brand-orange rounded-full p-0.5">
          <a href="/en/" class={`px-3 py-1 rounded-full text-xs font-bold transition-colors ${locale === 'en' ? 'bg-brand-orange text-brand-bg' : 'text-brand-navy hover:text-brand-orange'}`}>
            EN
          </a>
          <a href="/" class={`px-3 py-1 rounded-full text-xs font-bold transition-colors ${locale === 'es' ? 'bg-brand-orange text-brand-bg' : 'text-brand-navy hover:text-brand-orange'}`}>
            ES
          </a>
        </div>
        <a class="btn-primary text-sm font-bold" href={`${homeUrl}#contact`}>
          {t('header.getQuote', locale)}
        </a>
      </div>
    </nav>
  </div>
</header>
<script>
  const button=document.querySelector<HTMLButtonElement>('.menu-toggle');
  const nav=document.querySelector<HTMLElement>('#site-nav');
  if(button&&nav){
    const close=()=>{button.setAttribute('aria-expanded','false');nav.classList.remove('is-open');};
    button.addEventListener('click',()=>{
      const open=button.getAttribute('aria-expanded')!=='true';
      button.setAttribute('aria-expanded',String(open));nav.classList.toggle('is-open',open);
    });
    nav.addEventListener('click',event=>{if((event.target as Element).closest('a'))close();});
    document.addEventListener('keydown',event=>{if(event.key==='Escape'&&button.getAttribute('aria-expanded')==='true'){close();button.focus();}});
    document.addEventListener('click',event=>{if(!nav.contains(event.target as Node)&&!button.contains(event.target as Node))close();});
    matchMedia('(min-width:1024px)').addEventListener('change',close);
  }
</script>
<style>
 @media(max-width:1023px){
  header{position:sticky}
  .site-nav.is-open{display:flex;position:absolute;top:100%;left:0;right:0;background:var(--color-brand-bg);padding:20px;flex-direction:column;align-items:stretch;border-bottom:1px solid var(--color-brand-dark);max-height:calc(100dvh - 88px);overflow-y:auto}
  .site-nav>div:first-child{display:flex;flex-direction:column;align-items:stretch}
  .site-nav>div:first-child a{min-height:44px;display:flex;align-items:center}
  .site-nav>div:last-child{display:flex;flex-wrap:wrap;gap:16px}
  .site-nav>div:last-child>div a{min-height:44px;min-width:44px;display:grid;place-items:center}
 }
</style>
